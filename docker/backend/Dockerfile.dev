# Multi-stage build for backend service
FROM python:3.13-slim AS base

# Install system dependencies and Node.js
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        postgresql-client \
        git \
        build-essential \
        pandoc \
        curl \
        supervisor \
        ca-certificates \
        gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install typst (not in apt; download from GitHub releases)
RUN TYPST_VERSION=$(curl -s https://api.github.com/repos/typst/typst/releases/latest | grep '"tag_name"' | sed 's/.*"v\([^"]*\)".*/\1/') && \
    curl -L "https://github.com/typst/typst/releases/latest/download/typst-x86_64-unknown-linux-musl.tar.xz" \
    | tar -xJ --strip-components=1 -C /usr/local/bin "typst-x86_64-unknown-linux-musl/typst"

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /workspace/studio/backend

# Copy dependency files (sync happens in entrypoint after rsm mount is available)
COPY backend/pyproject.toml backend/uv.lock ./

# Development stage
FROM base AS dev

# Copy env-check script and .env file
COPY docker/env-check.js ../docker/env-check.js
COPY .env ../.env

# Copy supervisord configuration and health check
COPY docker/supervisord.dev.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/health-check.sh /usr/local/bin/health-check.sh
RUN chmod +x /usr/local/bin/health-check.sh

# Dependencies will be synced in entrypoint when /workspace/rsm is available

# Set up environment
ENV PATH="/workspace/studio/backend/.venv/bin:$PATH"
ENV PYTHONPATH="/workspace/studio/backend"

# Note: Design assets are mounted as volume in dev mode via docker-compose
# For production builds, they would be copied here

# Copy entrypoint script
COPY docker/backend/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expose ports: 8000 (HTTP), 1234 (WebSocket)
EXPOSE 8000 1234

# Set entrypoint
ENTRYPOINT ["docker-entrypoint.sh"]

# Start supervisord (which manages backend, multiplayer, lsp)
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
