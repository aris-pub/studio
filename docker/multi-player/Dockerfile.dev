# Multi-stage build for multi-player server
FROM node:20-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Work from workspace root so pnpm hoists correctly
WORKDIR /workspace

# Copy all workspace package.json files and config
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc package.json ./
COPY frontend/package.json frontend/package.json
COPY site/package.json site/package.json
COPY multi-player/package.json multi-player/package.json

# Install all workspace dependencies (hoisted to /workspace/node_modules)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Development stage
FROM base AS dev

# Copy env-check script and .env file
COPY docker/env-check.js docker/env-check.js
COPY .env .env

# Copy entrypoint script
COPY docker/multi-player/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /workspace/multi-player

# Expose WebSocket port
EXPOSE 1234

# Use entrypoint script
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default development server command
CMD ["pnpm", "run", "dev"]
