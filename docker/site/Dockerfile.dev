# Multi-stage build for site service
FROM node:20-alpine AS base

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy package files and workspace config for optimal layer caching
COPY site/package.json ./
COPY pnpm-lock.yaml ../pnpm-lock.yaml
COPY pnpm-workspace.yaml ../pnpm-workspace.yaml
COPY .npmrc ../.npmrc

# Install production dependencies with cache mount
# Skip postinstall (Playwright browsers not needed in container)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    cd .. && pnpm install --frozen-lockfile --filter site... --ignore-scripts

# Development stage with dev dependencies
FROM base AS dev

# Install all dependencies including dev dependencies
# Skip postinstall (Playwright) since tests run on host, not in container
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    cd .. && pnpm install --frozen-lockfile --filter site... --ignore-scripts

# Copy env-check script and .env file
COPY docker/env-check.js ../docker/env-check.js
COPY .env ../.env

# Expose port
EXPOSE 3000

# Start development server
CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
