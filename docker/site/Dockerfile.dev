# Multi-stage build for site service
FROM node:20-alpine AS base

# Install pnpm and native build deps for allowlisted packages (esbuild, parcel/watcher, etc.)
RUN apk add --no-cache python3 make g++ && \
    corepack enable && corepack prepare pnpm@9 --activate

# Work from workspace root so pnpm hoists correctly
WORKDIR /workspace

# Copy all workspace package.json files and config
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc package.json ./
COPY frontend/package.json frontend/package.json
COPY site/package.json site/package.json
COPY multi-player/package.json multi-player/package.json

# Install all workspace dependencies (hoisted to /workspace/node_modules)
# --ignore-scripts prevents postinstall from trying to install Playwright (needs apt-get, not available on Alpine)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts && \
    pnpm rebuild esbuild || true

# Development stage
FROM base AS dev

# Copy env-check script and .env file
COPY docker/env-check.js docker/env-check.js
COPY .env .env

# Copy entrypoint script
COPY docker/site/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace/site

# Expose port
EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
