# Multi-stage build for site service
FROM node:20-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Work from workspace root so pnpm hoists correctly
WORKDIR /workspace

# Copy workspace config and site package.json
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY site/package.json site/package.json

# Install production dependencies with cache mount
# Skip postinstall (Playwright browsers not needed in container)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter site... --ignore-scripts

# Development stage with dev dependencies
FROM base AS dev

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter site... --ignore-scripts

# Copy env-check script and .env file
COPY docker/env-check.js docker/env-check.js
COPY .env .env

WORKDIR /workspace/site

# Expose port
EXPOSE 3000

# Start development server
CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
