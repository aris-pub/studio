# Multi-stage build for frontend services
FROM node:20-alpine AS base

WORKDIR /app

# Set npm configuration for better performance
RUN npm config set fund false && \
    npm config set audit false

# Copy package files first for optimal layer caching
COPY frontend/package*.json ./

# Install dependencies with cache mount for faster builds
# Skip postinstall in base stage (Playwright browsers not needed for prod dependencies)
RUN --mount=type=cache,target=/root/.npm \
    npm ci --only=production --ignore-scripts

# Development stage with dev dependencies
FROM base AS dev

# Install all dependencies including dev dependencies
# Skip postinstall (Playwright) since tests run on host, not in container
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

# Copy env-check script, patch script, and .env file
COPY docker/env-check.js ../docker/env-check.js
COPY frontend/scripts/patch-y-codemirror.cjs /app/scripts/patch-y-codemirror.cjs
COPY .env ../.env

# Copy and setup entrypoint script
COPY docker/frontend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expose ports for Vite dev server and Storybook
EXPOSE 5173 6006

# Use entrypoint to install optional deps after volume mount
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default development server command (can be overridden in docker-compose)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]