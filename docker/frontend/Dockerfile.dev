# Multi-stage build for frontend services
FROM node:20-alpine AS base

# Install pnpm and native build deps for allowlisted packages (esbuild, parcel/watcher, etc.)
RUN apk add --no-cache python3 make g++ && \
    corepack enable && corepack prepare pnpm@9 --activate

# Work from workspace root so pnpm hoists correctly
WORKDIR /workspace

# Copy all workspace package.json files and config
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc package.json ./
COPY frontend/package.json frontend/package.json
COPY site/package.json site/package.json
COPY multi-player/package.json multi-player/package.json

# Install all workspace dependencies (hoisted to /workspace/node_modules)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Development stage
FROM base AS dev

# Copy env-check script, patch script, and .env file
COPY docker/env-check.js docker/env-check.js
COPY frontend/scripts/patch-y-codemirror.cjs frontend/scripts/patch-y-codemirror.cjs
COPY .env .env

# Copy and setup entrypoint script
COPY docker/frontend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /workspace/frontend

# Expose ports for Vite dev server and Storybook
EXPOSE 5173 6006

# Use entrypoint to install optional deps after volume mount
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default development server command (can be overridden in docker-compose)
CMD ["pnpm", "run", "dev", "--host", "0.0.0.0"]
