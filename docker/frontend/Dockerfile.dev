# Multi-stage build for frontend services
FROM node:20-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Work from workspace root so pnpm hoists correctly
WORKDIR /workspace

# Copy workspace config and frontend package.json
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY frontend/package.json frontend/package.json

# Install dependencies with cache mount for faster builds
# Skip postinstall in base stage (Playwright browsers not needed for prod dependencies)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter frontend... --ignore-scripts

# Development stage with dev dependencies
FROM base AS dev

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter frontend... --ignore-scripts

# Copy env-check script, patch script, and .env file
COPY docker/env-check.js docker/env-check.js
COPY frontend/scripts/patch-y-codemirror.cjs frontend/scripts/patch-y-codemirror.cjs
COPY .env .env

# Copy and setup entrypoint script
COPY docker/frontend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /workspace/frontend

# Expose ports for Vite dev server and Storybook
EXPOSE 5173 6006

# Use entrypoint to install optional deps after volume mount
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default development server command (can be overridden in docker-compose)
CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0"]
