# Frontend-specific configuration
# Copy this file to .env and update the values as needed for your environment.
# NOTE: Infrastructure variables (ports, URLs) are in root .env, not here.

# Environment mode
VITE_ENV=DEV

# Production API URL (development URL comes from root .env)
VITE_API_BASE_URL_PROD=https://your-production-api.example.com

# Dev login credentials: when VITE_ENV=DEV, prefill login form from these values
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=
