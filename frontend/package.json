{
  "name": "aris",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../docker/env-check.js && vite",
    "build": "node ../docker/env-check.js && vite build",
    "preview": "node ../docker/env-check.js && vite preview",
    "lint": "eslint . --fix",
    "test": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs",
    "test:run": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run --silent",
    "test:browser": "vitest --config vitest.browser.config.js",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:e2e": "node --max-old-space-size=2048 ./node_modules/playwright/cli.js test --reporter=line --quiet --grep-invert '@mobile-only'",
    "test:e2e:all": "CI=true playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:visual": "playwright test --grep @visual",
    "test:all": "npm run test:run && npm run test:e2e",
    "storybook": "node ../docker/env-check.js && storybook dev -p ${STORYBOOK_PORT}",
    "build-storybook": "node ../docker/env-check.js && storybook build",
    "postinstall": "([ \"$NETLIFY\" = \"true\" ] || npx playwright install chromium firefox webkit --with-deps) && node scripts/patch-y-codemirror.cjs"
  },
  "dependencies": {
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "6.10.1",
    "@codemirror/lsp-client": "^6.2.1",
    "@codemirror/state": "6.5.4",
    "@codemirror/view": "6.39.11",
    "@floating-ui/vue": "^1.1.6",
    "@tabler/icons-vue": "^3.34.0",
    "@vueuse/core": "^13.4.0",
    "@yaireo/relative-time": "^1.1.0",
    "axios": "^1.10.0",
    "codemirror": "6.0.2",
    "jquery": "^3.6.0",
    "tooltipster": "^4.2.8",
    "vue": "^3.5.30",
    "vue-router": "^4.5.0",
    "ws": "^8.19.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/eslint-parser": "^7.27.5",
    "@babel/plugin-syntax-import-assertions": "^7.26.0",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.53.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-viewport": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/vue3-vite": "^8.6.14",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^16.4.7",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-storybook": "^0.11.6",
    "eslint-plugin-vue": "~10.6.2",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.53.1",
    "prettier": "^3.5.3",
    "puppeteer": "^24.35.0",
    "puppeteer-core": "^24.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "vite": "^6.2.1",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.1.3"
  }
}
