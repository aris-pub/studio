{
  "name": "aris",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../docker/env-check.js && vite",
    "build": "node ../docker/env-check.js && vite build",
    "preview": "node ../docker/env-check.js && vite preview",
    "lint": "eslint . --fix",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' pnpm exec vitest",
    "test:run": "NODE_OPTIONS='--max-old-space-size=4096' pnpm exec vitest run --silent",
    "test:browser": "vitest --config vitest.browser.config.js",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:e2e": "node --max-old-space-size=2048 ./node_modules/playwright/cli.js test --reporter=line --quiet --grep-invert '@mobile-only'",
    "test:e2e:all": "CI=true playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:visual": "playwright test --grep @visual",
    "test:all": "pnpm run test:run && pnpm run test:e2e",
    "storybook": "node ../docker/env-check.js && storybook dev -p ${STORYBOOK_PORT}",
    "build-storybook": "node ../docker/env-check.js && storybook build",
    "postinstall": "([ \"$NETLIFY\" = \"true\" ] || pnpm exec playwright install chromium firefox webkit --with-deps) && node scripts/patch-y-codemirror.cjs"
  },
  "dependencies": {
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lsp-client": "^6.2.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "@floating-ui/vue": "^1.1.6",
    "@tabler/icons-vue": "^3.44.0",
    "@vueuse/core": "^14.3.0",
    "@yaireo/relative-time": "^1.1.0",
    "axios": "^1.16.0",
    "codemirror": "6.0.2",
    "htmlparser2": "^12.0.0",
    "jquery": "^4.0.0",
    "tooltipster": "^4.2.8",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "ws": "^8.20.1",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/eslint-parser": "^7.27.5",
    "@babel/plugin-syntax-import-assertions": "^7.26.0",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.4.0",
    "@storybook/addon-viewport": "^9.0.8",
    "@storybook/test": "^8.6.14",
    "@storybook/vue3-vite": "^10.4.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-storybook": "^10.4.0",
    "eslint-plugin-vue": "~10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.53.1",
    "prettier": "^3.8.3",
    "puppeteer": "^25.0.4",
    "puppeteer-core": "^25.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.4.0",
    "vite": "^8.0.13",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.6",
    "vue-eslint-parser": "^10.1.3"
  }
}
