# Aris Backend Environment Variables
# These are SAFE DEFAULT VALUES for CI/testing
# For local development: copy to .env and update with your actual values
# For production: NEVER use these values - set real secrets in environment

# Database Configuration (uses default Docker postgres credentials)
# SAFE FOR CI: connects to local Docker containers, NOT production
DB_URL_LOCAL=postgresql+asyncpg://postgres:postgres@postgres:5432/aris
DB_URL_PROD=postgresql+asyncpg://postgres:postgres@postgres:5432/aris
ALEMBIC_DB_URL_LOCAL=postgresql+psycopg2://postgres:postgres@postgres:5432/aris
ALEMBIC_DB_URL_PROD=postgresql+psycopg2://postgres:postgres@postgres:5432/aris
ENV=DEV

# Test Configuration (safe public test credentials)
TEST_USER_EMAIL=testuser@aris.pub
TEST_USER_PASSWORD=testpassword123

# JWT Configuration (SAFE FOR CI: random string for testing only)
# For production: generate a secure random key with: openssl rand -base64 64
JWT_SECRET_KEY=test_jwt_secret_key_for_ci_development_only_min_32_chars_required_not_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Email Configuration (blank = disabled for testing)
RESEND_API_KEY=
FROM_EMAIL=noreply@aris.pub
ADMIN_EMAIL=
