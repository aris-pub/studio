# Environment Configuration for Aris Development
# Copy this file to .env and set the actual values for your environment
# ALL variables are REQUIRED - no fallbacks are provided

# Backend configuration
BACKEND_PORT=8000

# Frontend configuration
FRONTEND_PORT=5173
STORYBOOK_PORT=6006
VITE_API_BASE_URL=http://localhost:8000

# Multi-player server configuration
MULTIPLAYER_PORT=1234
VITE_MULTIPLAYER_URL=ws://localhost:1234

# Site configuration
SITE_PORT=3000
NUXT_BACKEND_URL=http://localhost:8000

# Database configuration
DB_PORT=5432
DB_NAME=aris
TEST_DB_NAME=aris_test

# Example configurations for multiple development clones:
# Clone 1: BACKEND_PORT=8000, FRONTEND_PORT=5173, MULTIPLAYER_PORT=1234, DB_PORT=5432
# Clone 2: BACKEND_PORT=8001, FRONTEND_PORT=5174, MULTIPLAYER_PORT=1235, DB_PORT=5433
# Clone 3: BACKEND_PORT=8002, FRONTEND_PORT=5175, MULTIPLAYER_PORT=1236, DB_PORT=5434