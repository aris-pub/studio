{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-assets": "mkdir -p public/brand && cp -r ../brand/logos/studio/* public/brand/",
    "prebuild": "npm run copy-assets",
    "predev": "npm run copy-assets",
    "pregenerate": "npm run copy-assets",
    "build": "node ../docker/env-check.js && nuxt build",
    "dev": "node ../docker/env-check.js && nuxt dev",
    "generate": "node ../docker/env-check.js && nuxt generate",
    "preview": "node ../docker/env-check.js && nuxt preview",
    "postinstall": "nuxt prepare && npx playwright install chromium --with-deps",
    "lint": "eslint . --fix",
    "test": "node ../docker/env-check.js && node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs",
    "test:run": "node ../docker/env-check.js && node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ../docker/env-check.js && vitest run --coverage",
    "test:coverage:ui": "node ../docker/env-check.js && vitest --coverage --ui",
    "test:e2e": "node ../docker/env-check.js && node --env-file=../.env --max-old-space-size=2048 ./node_modules/playwright/cli.js test --reporter=line --quiet",
    "test:e2e:all": "node ../docker/env-check.js && CI=true node --env-file=../.env ./node_modules/playwright/cli.js test",
    "test:e2e:ui": "node ../docker/env-check.js && node --env-file=../.env ./node_modules/playwright/cli.js test --ui",
    "test:e2e:debug": "node ../docker/env-check.js && node --env-file=../.env ./node_modules/playwright/cli.js test --debug",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:all:ci": "npm run test:run && npm run test:e2e:all",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@nuxt/image": "^1.10.0",
    "@nuxt/scripts": "^0.11.8",
    "@nuxt/test-utils": "^3.19.1",
    "@tabler/icons-vue": "^3.34.0",
    "@unhead/vue": "^2.0.10",
    "nuxt": "^3.17.5",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.27.5",
    "@babel/plugin-syntax-import-assertions": "^7.27.1",
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@playwright/test": "^1.53.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "axios": "^1.10.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-storybook": "^9.0.16",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.2.0",
    "happy-dom": "^17.6.3",
    "jsdom": "^26.1.0",
    "puppeteer": "^24.10.2",
    "puppeteer-core": "^24.10.2",
    "vitest": "^3.2.4"
  }
}
